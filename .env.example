# PostgreSQL container
DB_NAME=fieldnotes
DB_PORT=5432
DB_USER=fieldnotes
DB_PASSWORD=fieldnotes

# Spring Boot API
PORT=8080
SERVER_ADDRESS=0.0.0.0
DB_URL=jdbc:postgresql://localhost:5432/fieldnotes
# Optional for local development. If omitted, each backend start generates a
# random key and existing login tokens expire. Set a random 32+ byte value to
# keep sessions valid across restarts. Never use this comment as the value.
# JWT_SECRET=<generate-a-random-32-byte-or-longer-secret>
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30
PHOTO_DIR=./uploads
# On Render set SPRING_PROFILES_ACTIVE=prod and a long random JWT_SECRET.
# SPRING_PROFILES_ACTIVE=prod

# Optional Flutter override. Leave empty to select localhost automatically,
# or 10.0.2.2 when the selected device is Android.
API_BASE_URL=
