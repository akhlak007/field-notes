# PostgreSQL container
DB_NAME=fieldnotes
DB_PORT=5432
DB_USER=fieldnotes
DB_PASSWORD=fieldnotes

# Spring Boot API
PORT=8080
SERVER_ADDRESS=0.0.0.0
DB_URL=jdbc:postgresql://localhost:5432/fieldnotes
JWT_SECRET=field-notes-dev-secret-change-me-32bytes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30
PHOTO_DIR=./uploads
# On Render set SPRING_PROFILES_ACTIVE=prod and a long random JWT_SECRET.
# SPRING_PROFILES_ACTIVE=prod

# Optional Flutter override. Leave empty to select localhost automatically,
# or 10.0.2.2 when the selected device is Android.
API_BASE_URL=
