<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug/profile builds may talk to a laptop on LAN over HTTP. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
